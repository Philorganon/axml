    <!-- TRACK 2: SNARE (640 Beats Non-Stop) -->
    <track instrument="electro_snare" name="Non-Stop Snare">
      <play pattern="snare_nonstop" start="0" /><play pattern="snare_nonstop" start="16" /><play pattern="snare_nonstop" start="32" /><play pattern="snare_nonstop" start="48" />
      <play pattern="snare_nonstop" start="64" /><play pattern="snare_nonstop" start="80" /><play pattern="snare_nonstop" start="96" /><play pattern="snare_nonstop" start="112" />
      <play pattern="snare_nonstop" start="128" /><play pattern="snare_nonstop" start="144" /><play pattern="snare_nonstop" start="160" /><play pattern="snare_nonstop" start="176" />
      <play pattern="snare_nonstop" start="192" /><play pattern="snare_nonstop" start="208" /><play pattern="snare_nonstop" start="224" /><play pattern="snare_nonstop" start="240" />
      <play pattern="snare_nonstop" start="256" /><play pattern="snare_nonstop" start="272" /><play pattern="snare_nonstop" start="288" /><play pattern="snare_nonstop" start="304" />
      <play pattern="snare_nonstop" start="320" /><play pattern="snare_nonstop" start="336" /><play pattern="snare_nonstop" start="352" /><play pattern="snare_nonstop" start="368" />
      <play pattern="snare_nonstop" start="384" /><play pattern="snare_nonstop" start="400" /><play pattern="snare_nonstop" start="416" /><play pattern="snare_nonstop" start="432" />
      <play pattern="snare_nonstop" start="448" /><play pattern="snare_nonstop" start="464" /><play pattern="snare_nonstop" start="480" /><play pattern="snare_nonstop" start="496" />
      <play pattern="snare_nonstop" start="512" /><play pattern="snare_nonstop" start="528" /><play pattern="snare_nonstop" start="544" /><play pattern="snare_nonstop" start="560" />
      <play pattern="snare_nonstop" start="576" /><play pattern="snare_nonstop" start="592" /><play pattern="snare_nonstop" start="608" /><play pattern="snare_nonstop" start="624" />
    </track>

    <!-- TRACK 3: HI-HATS (640 Beats Non-Stop) -->
    <track instrument="electro_hat" name="Non-Stop Hi-Hats">
      <play pattern="hats_16th_intense" start="0" /><play pattern="hats_16th_intense" start="16" /><play pattern="hats_16th_intense" start="32" /><play pattern="hats_16th_intense" start="48" />
      <play pattern="hats_16th_intense" start="64" /><play pattern="hats_16th_intense" start="80" /><play pattern="hats_16th_intense" start="96" /><play pattern="hats_16th_intense" start="112" />
      <play pattern="hats_16th_intense" start="128" /><play pattern="hats_16th_intense" start="144" /><play pattern="hats_16th_intense" start="160" /><play pattern="hats_16th_intense" start="176" />
      <play pattern="hats_16th_intense" start="192" /><play pattern="hats_16th_intense" start="208" /><play pattern="hats_16th_intense" start="224" /><play pattern="hats_16th_intense" start="240" />
      <play pattern="hats_16th_intense" start="256" /><play pattern="hats_16th_intense" start="272" /><play pattern="hats_16th_intense" start="288" /><play pattern="hats_16th_intense" start="304" />
      <play pattern="hats_16th_intense" start="320" /><play pattern="hats_16th_intense" start="336" /><play pattern="hats_16th_intense" start="352" /><play pattern="hats_16th_intense" start="368" />
      <play pattern="hats_16th_intense" start="384" /><play pattern="hats_16th_intense" start="400" /><play pattern="hats_16th_intense" start="416" /><play pattern="hats_16th_intense" start="432" />
      <play pattern="hats_16th_intense" start="448" /><play pattern="hats_16th_intense" start="464" /><play pattern="hats_16th_intense" start="480" /><play pattern="hats_16th_intense" start="496" />
      <play pattern="hats_16th_intense" start="512" /><play pattern="hats_16th_intense" start="528" /><play pattern="hats_16th_intense" start="544" /><play pattern="hats_16th_intense" start="560" />
      <play pattern="hats_16th_intense" start="576" /><play pattern="hats_16th_intense" start="592" /><play pattern="hats_16th_intense" start="608" /><play pattern="hats_16th_intense" start="624" />
    </track>

    <!-- TRACK 4: INTENSE ELECTRO BASS (640 Beats Non-Stop) -->
    <track instrument="elec_bass" name="Non-Stop Electro Bass">
      <play pattern="bass_fsharp_intense" start="0" /><play pattern="bass_fsharp_intense" start="16" /><play pattern="bass_fsharp_intense" start="32" /><play pattern="bass_fsharp_intense" start="48" />
      <play pattern="bass_fsharp_intense" start="64" /><play pattern="bass_fsharp_intense" start="80" /><play pattern="bass_fsharp_intense" start="96" /><play pattern="bass_fsharp_intense" start="112" />
      <play pattern="bass_fsharp_intense" start="128" /><play pattern="bass_fsharp_intense" start="144" /><play pattern="bass_fsharp_intense" start="160" /><play pattern="bass_fsharp_intense" start="176" />
      <play pattern="bass_fsharp_intense" start="192" /><play pattern="bass_fsharp_intense" start="208" /><play pattern="bass_fsharp_intense" start="224" /><play pattern="bass_fsharp_intense" start="240" />
      <play pattern="bass_fsharp_intense" start="256" /><play pattern="bass_fsharp_intense" start="272" /><play pattern="bass_fsharp_intense" start="288" /><play pattern="bass_fsharp_intense" start="304" />
      <play pattern="bass_fsharp_intense" start="320" /><play pattern="bass_fsharp_intense" start="336" /><play pattern="bass_fsharp_intense" start="352" /><play pattern="bass_fsharp_intense" start="368" />
      <play pattern="bass_fsharp_intense" start="384" /><play pattern="bass_fsharp_intense" start="400" /><play pattern="bass_fsharp_intense" start="416" /><play pattern="bass_fsharp_intense" start="432" />
      <play pattern="bass_fsharp_intense" start="448" /><play pattern="bass_fsharp_intense" start="464" /><play pattern="bass_fsharp_intense" start="480" /><play pattern="bass_fsharp_intense" start="496" />
      <play pattern="bass_fsharp_intense" start="512" /><play pattern="bass_fsharp_intense" start="528" /><play pattern="bass_fsharp_intense" start="544" /><play pattern="bass_fsharp_intense" start="560" />
      <play pattern="bass_fsharp_intense" start="576" /><play pattern="bass_fsharp_intense" start="592" /><play pattern="bass_fsharp_intense" start="608" /><play pattern="bass_fsharp_intense" start="624" />
    </track>

    <!-- TRACK 5: SUB BASS (640 Beats Non-Stop) -->
    <track instrument="sub_bass" name="Non-Stop Sub Bass">
      <play pattern="sub_chords_nonstop" start="0" /><play pattern="sub_chords_nonstop" start="16" /><play pattern="sub_chords_nonstop" start="32" /><play pattern="sub_chords_nonstop" start="48" />
