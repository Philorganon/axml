<?xml version="1.0" encoding="UTF-8"?>
<axml version="3.5">
  <metadata>
    <title>Elektronomia - 5 Min Non-Stop Intense Odyssey</title>
    <artist>Elektronomia &amp; AXML Master</artist>
    <tempo>128</tempo>
    <key>F#m</key>
    <time-signature>4/4</time-signature>
    <duration>300</duration>
  </metadata>

  <instruments>
    <!-- Punchy Non-Stop EDM Kick -->
    <instrument id="electro_kick" type="kick" volume="1.0" attack="0.002" release="0.15" />
    
    <!-- Layered Snare & Clap -->
    <instrument id="electro_snare" type="snare" volume="0.85" attack="0.005" release="0.12" cutoff="3800" />
    
    <!-- Driving 16th Hi-Hats -->
    <instrument id="electro_hat" type="hihat" volume="0.6" attack="0.003" release="0.05" cutoff="9800" />
    
    <!-- Heavy Sidechained Electro Bass -->
    <instrument id="elec_bass" type="sawtooth" volume="0.85" attack="0.005" decay="0.15" sustain="0.75" release="0.15" cutoff="1000" resonance="14" distortion="0.4" />
    <instrument id="sub_bass" type="sine" volume="0.8" attack="0.01" decay="0.2" sustain="0.85" release="0.2" cutoff="320" />
    
    <!-- Lead Synths -->
    <instrument id="saw_lead" type="sawtooth" volume="0.75" attack="0.01" decay="0.15" sustain="0.65" release="0.3" cutoff="5000" chorus="0.6" reverb="0.45" />
    <instrument id="super_lead" type="square" volume="0.65" attack="0.01" decay="0.2" sustain="0.45" release="0.2" cutoff="5800" distortion="0.2" reverb="0.5" />
    
    <!-- Wall of Sound Pads, Arps & Brass -->
    <instrument id="synth_pad" type="triangle" volume="0.5" attack="0.4" decay="0.3" sustain="0.85" release="1.0" cutoff="2500" chorus="0.7" reverb="0.7" />
    <instrument id="hero_arp" type="square" volume="0.45" attack="0.01" decay="0.1" sustain="0.35" release="0.1" cutoff="4500" arp="up" arpRate="0.25" octaves="2" reverb="0.5" />
    <instrument id="brass_stab" type="sawtooth" volume="0.65" attack="0.02" decay="0.1" sustain="0.35" release="0.2" cutoff="4000" resonance="8" />
  </instruments>

  <patterns>
    <!-- 1 BAR DRUMS -->
    <pattern id="kick_nonstop">
      <note pitch="C2" start="0" duration="q" />
      <note pitch="C2" start="1" duration="q" />
      <note pitch="C2" start="2" duration="q" />
      <note pitch="C2" start="3" duration="q" />
    </pattern>

    <pattern id="snare_nonstop">
      <note pitch="D2" start="1" duration="q" />
      <note pitch="D2" start="3" duration="q" />
    </pattern>

    <pattern id="hats_16th_intense">
      <note pitch="F#2" start="0" duration="s" /><note pitch="F#2" start="0.25" duration="s" />
      <note pitch="F#2" start="0.5" duration="s" /><note pitch="F#2" start="0.75" duration="s" />
      <note pitch="F#2" start="1" duration="s" /><note pitch="F#2" start="1.25" duration="s" />
      <note pitch="F#2" start="1.5" duration="s" /><note pitch="F#2" start="1.75" duration="s" />
      <note pitch="F#2" start="2" duration="s" /><note pitch="F#2" start="2.25" duration="s" />
      <note pitch="F#2" start="2.5" duration="s" /><note pitch="F#2" start="2.75" duration="s" />
      <note pitch="F#2" start="3" duration="s" /><note pitch="F#2" start="3.25" duration="s" />
      <note pitch="F#2" start="3.5" duration="s" /><note pitch="F#2" start="3.75" duration="s" />
    </pattern>

    <!-- 4 BAR BASS -->
    <pattern id="bass_fsharp_intense">
      <note pitch="F#1" start="0" duration="e" /><note pitch="F#1" start="0.5" duration="e" /><note pitch="F#1" start="1" duration="e" /><note pitch="F#1" start="1.5" duration="e" />
      <note pitch="F#1" start="2" duration="e" /><note pitch="F#1" start="2.5" duration="e" /><note pitch="A1" start="3" duration="e" /><note pitch="C#2" start="3.5" duration="e" />
      <note pitch="D2" start="4" duration="e" /><note pitch="D2" start="4.5" duration="e" /><note pitch="D2" start="5" duration="e" /><note pitch="D2" start="5.5" duration="e" />
      <note pitch="D2" start="6" duration="e" /><note pitch="D2" start="6.5" duration="e" /><note pitch="F#2" start="7" duration="e" /><note pitch="A2" start="7.5" duration="e" />
      <note pitch="A1" start="8" duration="e" /><note pitch="A1" start="8.5" duration="e" /><note pitch="A1" start="9" duration="e" /><note pitch="A1" start="9.5" duration="e" />
      <note pitch="A1" start="10" duration="e" /><note pitch="A1" start="10.5" duration="e" /><note pitch="C#2" start="11" duration="e" /><note pitch="E2" start="11.5" duration="e" />
      <note pitch="E2" start="12" duration="e" /><note pitch="E2" start="12.5" duration="e" /><note pitch="E2" start="13" duration="e" /><note pitch="E2" start="13.5" duration="e" />
      <note pitch="E2" start="14" duration="e" /><note pitch="E2" start="14.5" duration="e" /><note pitch="G#2" start="15" duration="e" /><note pitch="B2" start="15.5" duration="e" />
    </pattern>

    <pattern id="sub_chords_nonstop">
      <note pitch="F#1" start="0" duration="4" />
      <note pitch="D1" start="4" duration="4" />
      <note pitch="A1" start="8" duration="4" />
      <note pitch="E1" start="12" duration="4" />
    </pattern>

    <!-- 4 BAR LEADS -->
    <pattern id="lead_anthem_main">
      <note pitch="C#5" start="0" duration="e" /><note pitch="F#5" start="0.5" duration="e" /><note pitch="G#5" start="1" duration="q" />
      <note pitch="A5" start="2" duration="e" /><note pitch="G#5" start="2.5" duration="e" /><note pitch="F#5" start="3" duration="q" />
      <note pitch="D5" start="4" duration="e" /><note pitch="F#5" start="4.5" duration="e" /><note pitch="A5" start="5" duration="q" />
      <note pitch="B5" start="6" duration="q" /><note pitch="C#6" start="7" duration="q" />
      <note pitch="C#6" start="8" duration="e" /><note pitch="B5" start="8.5" duration="e" /><note pitch="A5" start="9" duration="q" />
      <note pitch="G#5" start="10" duration="e" /><note pitch="F#5" start="10.5" duration="e" /><note pitch="E5" start="11" duration="q" />
      <note pitch="F#5" start="12" duration="q" /><note pitch="G#5" start="13" duration="q" /><note pitch="A5" start="14" duration="h" />
    </pattern>

    <pattern id="lead_counter_skyhigh">
      <note pitch="F#5" start="0" duration="q" /><note pitch="A5" start="1" duration="q" /><note pitch="C#6" start="2" duration="h" />
      <note pitch="B5" start="4" duration="q" /><note pitch="A5" start="5" duration="q" /><note pitch="G#5" start="6" duration="h" />
      <note pitch="A5" start="8" duration="q" /><note pitch="F#5" start="9" duration="q" /><note pitch="D5" start="10" duration="h" />
      <note pitch="E5" start="12" duration="q" /><note pitch="G#5" start="13" duration="q" /><note pitch="F#5" start="14" duration="h" />
    </pattern>

    <!-- 4 BAR PADS, ARPS & BRASS -->
    <pattern id="pad_chords_wall">
      <chord start="0" duration="4"><note pitch="F#3"/><note pitch="A3"/><note pitch="C#4"/><note pitch="F#4"/></chord>
      <chord start="4" duration="4"><note pitch="D3"/><note pitch="F#3"/><note pitch="A3"/><note pitch="D4"/></chord>
      <chord start="8" duration="4"><note pitch="A3"/><note pitch="C#4"/><note pitch="E4"/><note pitch="A4"/></chord>
      <chord start="12" duration="4"><note pitch="E3"/><note pitch="G#3"/><note pitch="B3"/><note pitch="E4"/></chord>
    </pattern>

    <pattern id="brass_stabs_heavy">
      <chord start="0" duration="e"><note pitch="F#4"/><note pitch="A4"/><note pitch="C#5"/></chord>
      <chord start="1.5" duration="e"><note pitch="F#4"/><note pitch="A4"/><note pitch="C#5"/></chord>
      <chord start="2.5" duration="e"><note pitch="F#4"/><note pitch="A4"/><note pitch="C#5"/></chord>
      <chord start="4" duration="e"><note pitch="D4"/><note pitch="F#4"/><note pitch="A4"/></chord>
      <chord start="5.5" duration="e"><note pitch="D4"/><note pitch="F#4"/><note pitch="A4"/></chord>
      <chord start="6.5" duration="e"><note pitch="D4"/><note pitch="F#4"/><note pitch="A4"/></chord>
      <chord start="8" duration="e"><note pitch="A4"/><note pitch="C#5"/><note pitch="E5"/></chord>
      <chord start="9.5" duration="e"><note pitch="A4"/><note pitch="C#5"/><note pitch="E5"/></chord>
      <chord start="10.5" duration="e"><note pitch="A4"/><note pitch="C#5"/><note pitch="E5"/></chord>
      <chord start="12" duration="e"><note pitch="E4"/><note pitch="G#4"/><note pitch="B4"/></chord>
      <chord start="13.5" duration="e"><note pitch="E4"/><note pitch="G#4"/><note pitch="B4"/></chord>
      <chord start="14.5" duration="e"><note pitch="E4"/><note pitch="G#4"/><note pitch="B4"/></chord>
    </pattern>

    <pattern id="hero_arp_wall">
      <note pitch="F#4" start="0" duration="4" />
      <note pitch="D4" start="4" duration="4" />
      <note pitch="A4" start="8" duration="4" />
      <note pitch="E4" start="12" duration="4" />
    </pattern>
  </patterns>

  <tracks>
    <!-- TRACK 1: KICK (640 Beats Non-Stop / 5 Mins) -->
    <track instrument="electro_kick" name="Non-Stop Kick">
      <play pattern="kick_nonstop" start="0" /><play pattern="kick_nonstop" start="4" /><play pattern="kick_nonstop" start="8" /><play pattern="kick_nonstop" start="12" />
