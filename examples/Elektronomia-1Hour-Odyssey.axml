<?xml version="1.0" encoding="UTF-8"?>
<axml version="3.5">
  <metadata>
    <title>Elektronomia - 1 Hour Electro Odyssey</title>
    <artist>Elektronomia &amp; AXML Master</artist>
    <tempo>128</tempo>
    <key>F#m</key>
    <time-signature>4/4</time-signature>
    <duration>3600</duration>
  </metadata>

  <instruments>
    <!-- Punchy Electro Kick -->
    <instrument id="electro_kick" type="kick" volume="1.0" attack="0.002" release="0.15" />
    
    <!-- Crisp Layered Snare & Clap -->
    <instrument id="electro_snare" type="snare" volume="0.85" attack="0.005" release="0.12" cutoff="3500" />
    <instrument id="electro_clap" type="snare" volume="0.75" attack="0.003" release="0.09" cutoff="4500" pan="0.2" />
    
    <!-- Driving Electro Hi-Hats -->
    <instrument id="electro_hat" type="hihat" volume="0.55" attack="0.003" release="0.05" cutoff="9500" />
    
    <!-- Signature Sidechained Electro Bass -->
    <instrument id="elec_bass" type="sawtooth" volume="0.85" attack="0.005" decay="0.15" sustain="0.7" release="0.15" cutoff="900" resonance="12" distortion="0.35" />
    <instrument id="sub_bass" type="sine" volume="0.8" attack="0.01" decay="0.2" sustain="0.85" release="0.2" cutoff="300" />
    
    <!-- Elektronomia Iconic Detuned Saw Lead -->
    <instrument id="saw_lead" type="sawtooth" volume="0.7" attack="0.01" decay="0.15" sustain="0.6" release="0.3" cutoff="4800" chorus="0.55" reverb="0.4" />
    
    <!-- Bright Square Pluck & Anthem Lead -->
    <instrument id="super_lead" type="square" volume="0.6" attack="0.01" decay="0.2" sustain="0.4" release="0.2" cutoff="5500" distortion="0.15" reverb="0.5" />
    <instrument id="pluck_lead" type="sawtooth" volume="0.55" attack="0.005" decay="0.12" sustain="0.1" release="0.15" cutoff="3200" reverb="0.35" />
    
    <!-- Euphoric Synth Pad & Arp -->
    <instrument id="synth_pad" type="triangle" volume="0.45" attack="0.8" decay="0.4" sustain="0.85" release="1.5" cutoff="2200" chorus="0.7" reverb="0.7" />
    <instrument id="hero_arp" type="square" volume="0.4" attack="0.01" decay="0.1" sustain="0.3" release="0.1" cutoff="4000" arp="up" arpRate="0.25" octaves="2" reverb="0.5" />
    
    <!-- Electro House Brass Stabs -->
    <instrument id="brass_stab" type="sawtooth" volume="0.6" attack="0.02" decay="0.1" sustain="0.3" release="0.2" cutoff="3800" resonance="6" />
  </instruments>

  <patterns>
    <!-- RHYTHM PATTERNS (4 Beats / 1 Bar Each) -->
    <pattern id="kick_4on4">
      <note pitch="C2" start="0" duration="q" />
      <note pitch="C2" start="1" duration="q" />
      <note pitch="C2" start="2" duration="q" />
      <note pitch="C2" start="3" duration="q" />
    </pattern>

    <pattern id="snare_2and4">
      <note pitch="D2" start="1" duration="q" />
      <note pitch="D2" start="3" duration="q" />
    </pattern>

    <pattern id="hats_offbeat">
      <note pitch="F#2" start="0.5" duration="e" />
      <note pitch="F#2" start="1.5" duration="e" />
      <note pitch="F#2" start="2.5" duration="e" />
      <note pitch="F#2" start="3.5" duration="e" />
    </pattern>

    <pattern id="hats_16th_driving">
      <note pitch="F#2" start="0" duration="s" /><note pitch="F#2" start="0.25" duration="s" />
      <note pitch="F#2" start="0.5" duration="s" /><note pitch="F#2" start="0.75" duration="s" />
      <note pitch="F#2" start="1" duration="s" /><note pitch="F#2" start="1.25" duration="s" />
      <note pitch="F#2" start="1.5" duration="s" /><note pitch="F#2" start="1.75" duration="s" />
      <note pitch="F#2" start="2" duration="s" /><note pitch="F#2" start="2.25" duration="s" />
      <note pitch="F#2" start="2.5" duration="s" /><note pitch="F#2" start="2.75" duration="s" />
      <note pitch="F#2" start="3" duration="s" /><note pitch="F#2" start="3.25" duration="s" />
      <note pitch="F#2" start="3.5" duration="s" /><note pitch="F#2" start="3.75" duration="s" />
    </pattern>

    <pattern id="snare_buildup_bar">
      <note pitch="D2" start="0" duration="e" />
      <note pitch="D2" start="0.5" duration="e" />
      <note pitch="D2" start="1.0" duration="e" />
      <note pitch="D2" start="1.5" duration="e" />
      <note pitch="D2" start="2.0" duration="s" />
      <note pitch="D2" start="2.25" duration="s" />
      <note pitch="D2" start="2.5" duration="s" />
      <note pitch="D2" start="2.75" duration="s" />
      <note pitch="D2" start="3.0" duration="s" />
      <note pitch="D2" start="3.25" duration="s" />
      <note pitch="D2" start="3.5" duration="s" />
      <note pitch="D2" start="3.75" duration="s" />
    </pattern>

    <!-- BASSLINE PATTERNS (16 Beats / 4 Bars) -->
    <pattern id="bass_fsharp_electro">
      <!-- Bar 1 (F#m) -->
      <note pitch="F#1" start="0" duration="e" /><note pitch="F#1" start="0.5" duration="e" />
      <note pitch="F#1" start="1.5" duration="e" /><note pitch="A1" start="2.5" duration="e" />
      <note pitch="F#1" start="3.25" duration="e" />
      <!-- Bar 2 (D) -->
      <note pitch="D2" start="4" duration="e" /><note pitch="D2" start="4.5" duration="e" />
      <note pitch="D2" start="5.5" duration="e" /><note pitch="F#2" start="6.5" duration="e" />
      <note pitch="D2" start="7.25" duration="e" />
      <!-- Bar 3 (A) -->
      <note pitch="A1" start="8" duration="e" /><note pitch="A1" start="8.5" duration="e" />
      <note pitch="A1" start="9.5" duration="e" /><note pitch="C#2" start="10.5" duration="e" />
      <note pitch="A1" start="11.25" duration="e" />
      <!-- Bar 4 (E) -->
      <note pitch="E2" start="12" duration="e" /><note pitch="E2" start="12.5" duration="e" />
      <note pitch="E2" start="13.5" duration="e" /><note pitch="G#2" start="14.5" duration="e" />
      <note pitch="E2" start="15.25" duration="e" />
    </pattern>

    <pattern id="sub_chords_fsharp">
      <note pitch="F#1" start="0" duration="4" />
      <note pitch="D1" start="4" duration="4" />
      <note pitch="A1" start="8" duration="4" />
      <note pitch="E1" start="12" duration="4" />
    </pattern>

    <!-- MELODY PATTERNS (16 Beats / 4 Bars) -->
    <!-- Iconic Elektronomia Anthem Melody A -->
    <pattern id="lead_elektronomia_main">
      <!-- Phrase 1 (F#m) -->
      <note pitch="C#5" start="0" duration="e" />
      <note pitch="F#5" start="0.5" duration="e" />
      <note pitch="G#5" start="1" duration="q" />
      <note pitch="A5" start="2" duration="e" />
      <note pitch="G#5" start="2.5" duration="e" />
      <note pitch="F#5" start="3" duration="q" />
      <!-- Phrase 2 (D) -->
      <note pitch="D5" start="4" duration="e" />
      <note pitch="F#5" start="4.5" duration="e" />
      <note pitch="A5" start="5" duration="q" />
      <note pitch="B5" start="6" duration="q" />
      <note pitch="C#6" start="7" duration="q" />
      <!-- Phrase 3 (A) -->
      <note pitch="C#6" start="8" duration="e" />
      <note pitch="B5" start="8.5" duration="e" />
      <note pitch="A5" start="9" duration="q" />
      <note pitch="G#5" start="10" duration="e" />
      <note pitch="F#5" start="10.5" duration="e" />
      <note pitch="E5" start="11" duration="q" />
      <!-- Phrase 4 (E) -->
      <note pitch="F#5" start="12" duration="q" />
      <note pitch="G#5" start="13" duration="q" />
      <note pitch="A5" start="14" duration="h" />
    </pattern>

    <!-- Elektronomia Soaring Melody B (Second Drop Theme) -->
    <pattern id="lead_sky_high_theme">
      <!-- Phrase 1 -->
      <note pitch="F#5" start="0" duration="q" />
      <note pitch="A5" start="1" duration="q" />
      <note pitch="C#6" start="2" duration="h" />
      <!-- Phrase 2 -->
      <note pitch="B5" start="4" duration="q" />
      <note pitch="A5" start="5" duration="q" />
      <note pitch="G#5" start="6" duration="h" />
      <!-- Phrase 3 -->
      <note pitch="A5" start="8" duration="q" />
      <note pitch="F#5" start="9" duration="q" />
      <note pitch="D5" start="10" duration="h" />
      <!-- Phrase 4 -->
      <note pitch="E5" start="12" duration="q" />
      <note pitch="G#5" start="13" duration="q" />
      <note pitch="F#5" start="14" duration="h" />
    </pattern>

    <!-- Pluck Teaser Sequence -->
    <pattern id="pluck_teaser">
      <note pitch="F#4" start="0" duration="e" /><note pitch="A4" start="0.5" duration="e" />
      <note pitch="C#5" start="1" duration="e" /><note pitch="F#5" start="1.5" duration="e" />
      <note pitch="D4" start="4" duration="e" /><note pitch="F#4" start="4.5" duration="e" />
      <note pitch="A4" start="5" duration="e" /><note pitch="D5" start="5.5" duration="e" />
      <note pitch="A3" start="8" duration="e" /><note pitch="C#4" start="8.5" duration="e" />
      <note pitch="E4" start="9" duration="e" /><note pitch="A4" start="9.5" duration="e" />
      <note pitch="E4" start="12" duration="e" /><note pitch="G#4" start="12.5" duration="e" />
      <note pitch="B4" start="13" duration="e" /><note pitch="E5" start="13.5" duration="e" />
    </pattern>

    <!-- CHORD PAD PATTERNS (16 Beats / 4 Bars) -->
    <pattern id="pad_fsharp_progression">
      <chord start="0" duration="4"><note pitch="F#3"/><note pitch="A3"/><note pitch="C#4"/></chord>
      <chord start="4" duration="4"><note pitch="D3"/><note pitch="F#3"/><note pitch="A3"/></chord>
      <chord start="8" duration="4"><note pitch="A3"/><note pitch="C#4"/><note pitch="E4"/></chord>
      <chord start="12" duration="4"><note pitch="E3"/><note pitch="G#3"/><note pitch="B3"/></chord>
    </pattern>

    <!-- BRASS STABS PATTERN -->
    <pattern id="brass_stabs_fsharp">
      <chord start="0" duration="e"><note pitch="F#4"/><note pitch="A4"/><note pitch="C#5"/></chord>
      <chord start="2.5" duration="e"><note pitch="F#4"/><note pitch="A4"/><note pitch="C#5"/></chord>
      <chord start="4" duration="e"><note pitch="D4"/><note pitch="F#4"/><note pitch="A4"/></chord>
      <chord start="6.5" duration="e"><note pitch="D4"/><note pitch="F#4"/><note pitch="A4"/></chord>
      <chord start="8" duration="e"><note pitch="A4"/><note pitch="C#5"/><note pitch="E5"/></chord>
      <chord start="10.5" duration="e"><note pitch="A4"/><note pitch="C#5"/><note pitch="E5"/></chord>
      <chord start="12" duration="e"><note pitch="E4"/><note pitch="G#4"/><note pitch="B4"/></chord>
      <chord start="14.5" duration="e"><note pitch="E4"/><note pitch="G#4"/><note pitch="B4"/></chord>
    </pattern>

    <!-- HERO ARPEGGIATOR PATTERN -->
    <pattern id="hero_arp_fsharp">
      <note pitch="F#4" start="0" duration="4" />
      <note pitch="D4" start="4" duration="4" />
      <note pitch="A4" start="8" duration="4" />
      <note pitch="E4" start="12" duration="4" />
    </pattern>
  </patterns>

  <tracks>
    <!-- TRACK 1: KICK DRUM (7,680 Beats / 60 Minutes) -->
    <track instrument="electro_kick" name="Kick Drum">
      <!-- Intro atmosphere (0-128) -->
      <play pattern="kick_4on4" start="64" /><play pattern="kick_4on4" start="68" />
      <play pattern="kick_4on4" start="72" /><play pattern="kick_4on4" start="76" />
      <play pattern="kick_4on4" start="80" /><play pattern="kick_4on4" start="84" />
      <play pattern="kick_4on4" start="88" /><play pattern="kick_4on4" start="92" />
      <play pattern="kick_4on4" start="96" /><play pattern="kick_4on4" start="100" />
      <play pattern="kick_4on4" start="104" /><play pattern="kick_4on4" start="108" />
      <play pattern="kick_4on4" start="112" /><play pattern="kick_4on4" start="116" />
      <play pattern="kick_4on4" start="120" /><play pattern="kick_4on4" start="124" />

      <!-- PHASE 1: Sunrise Awakening (128-960) -->
      <!-- Drop 1 & Variations (256-768) -->
      <play pattern="kick_4on4" start="256" /><play pattern="kick_4on4" start="260" />
      <play pattern="kick_4on4" start="264" /><play pattern="kick_4on4" start="268" />
      <play pattern="kick_4on4" start="272" /><play pattern="kick_4on4" start="276" />
      <play pattern="kick_4on4" start="280" /><play pattern="kick_4on4" start="284" />
      <play pattern="kick_4on4" start="288" /><play pattern="kick_4on4" start="292" />
      <play pattern="kick_4on4" start="296" /><play pattern="kick_4on4" start="300" />
      <play pattern="kick_4on4" start="304" /><play pattern="kick_4on4" start="308" />
      <play pattern="kick_4on4" start="312" /><play pattern="kick_4on4" start="316" />
      <play pattern="kick_4on4" start="320" /><play pattern="kick_4on4" start="384" />
      <play pattern="kick_4on4" start="448" /><play pattern="kick_4on4" start="512" />
      <play pattern="kick_4on4" start="576" /><play pattern="kick_4on4" start="640" />
      <play pattern="kick_4on4" start="704" /><play pattern="kick_4on4" start="768" />

      <!-- PHASE 2: Cyber Horizon (960-1920) -->
      <play pattern="kick_4on4" start="1152" /><play pattern="kick_4on4" start="1216" />
      <play pattern="kick_4on4" start="1280" /><play pattern="kick_4on4" start="1344" />
      <play pattern="kick_4on4" start="1408" /><play pattern="kick_4on4" start="1472" />
      <play pattern="kick_4on4" start="1536" /><play pattern="kick_4on4" start="1600" />
      <play pattern="kick_4on4" start="1664" /><play pattern="kick_4on4" start="1728" />

      <!-- PHASE 3: Vitality & Limitless Flight (1920-2880) -->
      <play pattern="kick_4on4" start="2240" /><play pattern="kick_4on4" start="2304" />
      <play pattern="kick_4on4" start="2368" /><play pattern="kick_4on4" start="2432" />
      <play pattern="kick_4on4" start="2496" /><play pattern="kick_4on4" start="2560" />
      <play pattern="kick_4on4" start="2624" /><play pattern="kick_4on4" start="2688" />

      <!-- PHASE 4: Summer Breeze & Sunset Glow (2880-3840) -->
      <play pattern="kick_4on4" start="3200" /><play pattern="kick_4on4" start="3264" />
      <play pattern="kick_4on4" start="3328" /><play pattern="kick_4on4" start="3392" />
      <play pattern="kick_4on4" start="3456" /><play pattern="kick_4on4" start="3520" />
      <play pattern="kick_4on4" start="3584" /><play pattern="kick_4on4" start="3648" />

      <!-- PHASE 5: Neon Energy Rush (3840-4800) -->
      <play pattern="kick_4on4" start="4032" /><play pattern="kick_4on4" start="4096" />
      <play pattern="kick_4on4" start="4160" /><play pattern="kick_4on4" start="4224" />
      <play pattern="kick_4on4" start="4288" /><play pattern="kick_4on4" start="4352" />
      <play pattern="kick_4on4" start="4416" /><play pattern="kick_4on4" start="4480" />

      <!-- PHASE 6: Celestial Voyage (4800-5760) -->
      <play pattern="kick_4on4" start="5120" /><play pattern="kick_4on4" start="5184" />
      <play pattern="kick_4on4" start="5248" /><play pattern="kick_4on4" start="5312" />
      <play pattern="kick_4on4" start="5376" /><play pattern="kick_4on4" start="5440" />
      <play pattern="kick_4on4" start="5504" /><play pattern="kick_4on4" start="5568" />

      <!-- PHASE 7: The Grand Finale (5760-6720) -->
      <play pattern="kick_4on4" start="6080" /><play pattern="kick_4on4" start="6144" />
      <play pattern="kick_4on4" start="6208" /><play pattern="kick_4on4" start="6272" />
      <play pattern="kick_4on4" start="6336" /><play pattern="kick_4on4" start="6400" />
      <play pattern="kick_4on4" start="6464" /><play pattern="kick_4on4" start="6528" />

      <!-- PHASE 8: Endless Horizon Outro (6720-7680) -->
      <play pattern="kick_4on4" start="6720" /><play pattern="kick_4on4" start="6784" />
      <play pattern="kick_4on4" start="6848" /><play pattern="kick_4on4" start="6912" />
      <play pattern="kick_4on4" start="6976" /><play pattern="kick_4on4" start="7040" />
    </track>

    <!-- TRACK 2: SNARE & CLAP (Drums) -->
    <track instrument="electro_snare" name="Snare &amp; Buildup">
      <!-- Buildup 1 (240-256) -->
      <play pattern="snare_buildup_bar" start="240" /><play pattern="snare_buildup_bar" start="244" />
      <play pattern="snare_buildup_bar" start="248" /><play pattern="snare_buildup_bar" start="252" />

      <!-- Drops Snares (256-768) -->
      <play pattern="snare_2and4" start="256" /><play pattern="snare_2and4" start="260" />
      <play pattern="snare_2and4" start="264" /><play pattern="snare_2and4" start="268" />
      <play pattern="snare_2and4" start="272" /><play pattern="snare_2and4" start="276" />
      <play pattern="snare_2and4" start="280" /><play pattern="snare_2and4" start="284" />
      <play pattern="snare_2and4" start="288" /><play pattern="snare_2and4" start="292" />
      <play pattern="snare_2and4" start="296" /><play pattern="snare_2and4" start="300" />
      <play pattern="snare_2and4" start="304" /><play pattern="snare_2and4" start="308" />
      <play pattern="snare_2and4" start="312" /><play pattern="snare_2and4" start="316" />

      <!-- Buildups & Drops across 60 mins -->
      <play pattern="snare_buildup_bar" start="1136" /><play pattern="snare_buildup_bar" start="1144" />
      <play pattern="snare_2and4" start="1152" /><play pattern="snare_2and4" start="1216" />
      <play pattern="snare_2and4" start="1280" /><play pattern="snare_2and4" start="1344" />

      <play pattern="snare_buildup_bar" start="2224" /><play pattern="snare_buildup_bar" start="2232" />
      <play pattern="snare_2and4" start="2240" /><play pattern="snare_2and4" start="2304" />
      <play pattern="snare_2and4" start="2368" /><play pattern="snare_2and4" start="2432" />

      <play pattern="snare_buildup_bar" start="3184" /><play pattern="snare_buildup_bar" start="3192" />
      <play pattern="snare_2and4" start="3200" /><play pattern="snare_2and4" start="3264" />
      <play pattern="snare_2and4" start="3328" /><play pattern="snare_2and4" start="3392" />

      <play pattern="snare_buildup_bar" start="4016" /><play pattern="snare_buildup_bar" start="4024" />
      <play pattern="snare_2and4" start="4032" /><play pattern="snare_2and4" start="4096" />
      <play pattern="snare_2and4" start="4160" /><play pattern="snare_2and4" start="4224" />

      <play pattern="snare_buildup_bar" start="5104" /><play pattern="snare_buildup_bar" start="5112" />
      <play pattern="snare_2and4" start="5120" /><play pattern="snare_2and4" start="5184" />
      <play pattern="snare_2and4" start="5248" /><play pattern="snare_2and4" start="5312" />

      <play pattern="snare_buildup_bar" start="6064" /><play pattern="snare_buildup_bar" start="6072" />
      <play pattern="snare_2and4" start="6080" /><play pattern="snare_2and4" start="6144" />
      <play pattern="snare_2and4" start="6208" /><play pattern="snare_2and4" start="6272" />
      <play pattern="snare_2and4" start="6336" /><play pattern="snare_2and4" start="6400" />
    </track>

    <!-- TRACK 3: HI-HATS -->
    <track instrument="electro_hat" name="Driving Hi-Hats">
      <play pattern="hats_offbeat" start="128" /><play pattern="hats_offbeat" start="132" />
      <play pattern="hats_16th_driving" start="256" /><play pattern="hats_16th_driving" start="260" />
      <play pattern="hats_16th_driving" start="264" /><play pattern="hats_16th_driving" start="268" />
      <play pattern="hats_16th_driving" start="1152" /><play pattern="hats_16th_driving" start="1156" />
      <play pattern="hats_16th_driving" start="2240" /><play pattern="hats_16th_driving" start="2244" />
      <play pattern="hats_16th_driving" start="3200" /><play pattern="hats_16th_driving" start="3204" />
      <play pattern="hats_16th_driving" start="4032" /><play pattern="hats_16th_driving" start="4036" />
      <play pattern="hats_16th_driving" start="5120" /><play pattern="hats_16th_driving" start="5124" />
      <play pattern="hats_16th_driving" start="6080" /><play pattern="hats_16th_driving" start="6084" />
    </track>

    <!-- TRACK 4: SIDECHAIN ELECTRO BASSLINE -->
    <track instrument="elec_bass" name="Electro Bassline">
      <play pattern="bass_fsharp_electro" start="256" />
      <play pattern="bass_fsharp_electro" start="272" />
      <play pattern="bass_fsharp_electro" start="288" />
      <play pattern="bass_fsharp_electro" start="304" />
      <play pattern="bass_fsharp_electro" start="1152" />
      <play pattern="bass_fsharp_electro" start="1168" />
      <play pattern="bass_fsharp_electro" start="2240" />
      <play pattern="bass_fsharp_electro" start="2256" />
      <play pattern="bass_fsharp_electro" start="3200" />
      <play pattern="bass_fsharp_electro" start="3216" />
      <play pattern="bass_fsharp_electro" start="4032" />
      <play pattern="bass_fsharp_electro" start="4048" />
      <play pattern="bass_fsharp_electro" start="5120" />
      <play pattern="bass_fsharp_electro" start="5136" />
      <play pattern="bass_fsharp_electro" start="6080" />
      <play pattern="bass_fsharp_electro" start="6096" />
      <play pattern="bass_fsharp_electro" start="6112" />
      <play pattern="bass_fsharp_electro" start="6128" />
    </track>

    <!-- TRACK 5: SUB BASS -->
    <track instrument="sub_bass" name="Sub Bass">
      <play pattern="sub_chords_fsharp" start="0" />
      <play pattern="sub_chords_fsharp" start="16" />
      <play pattern="sub_chords_fsharp" start="256" />
      <play pattern="sub_chords_fsharp" start="272" />
      <play pattern="sub_chords_fsharp" start="1152" />
      <play pattern="sub_chords_fsharp" start="2240" />
      <play pattern="sub_chords_fsharp" start="3200" />
